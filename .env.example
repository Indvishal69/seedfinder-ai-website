# Copy this file to .env.local for local testing.
# On Vercel, add the same variable in Project Settings > Environment Variables.
# Never put this key in frontend code.
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

# Optional: change only if you know the model supports Google Search grounding.
# GEMINI_MODEL=gemini-3.5-flash

# Optional Google AdSense public settings. These are not secret, but set them in Vercel env vars.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_TOP_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=1234567891
# NEXT_PUBLIC_ADSENSE_RESULTS_SLOT=1234567892

# Optional: multiple legitimate Gemini API keys for failover.
# Do not use this to bypass provider limits; keys in the same Google project share quota.
# Option A: comma-separated
# GOOGLE_AI_API_KEYS=key_1,key_2,key_3
# Option B: separate variables
# GOOGLE_AI_API_KEY_2=second_google_ai_key
# GOOGLE_AI_API_KEY_3=third_google_ai_key

# Optional Groq fallback. Groq does NOT search the web by itself.
# For real web-sourced seeds with Groq fallback, also add SERPER_API_KEY.
# GROQ_API_KEY=your_first_groq_key
# GROQ_API_KEY_2=your_second_groq_key
# GROQ_API_KEYS=groq_key_1,groq_key_2
# GROQ_MODEL=llama-3.1-8b-instant

# Optional Serper search key for Groq fallback web results.
# SERPER_API_KEY=your_serper_dev_key
