# Copy this file to .env.local for local testing.
# On Vercel, add the same variables in Project Settings > Environment Variables.
# Never put private keys in frontend code.

# Gemini Google Search grounding keys. Add one or two legitimate Google AI Studio keys.
GOOGLE_AI_API_KEY=your_first_google_ai_studio_api_key_here
# GOOGLE_AI_API_KEY_2=your_second_google_ai_studio_api_key_here
# Or use comma-separated keys:
# GOOGLE_AI_API_KEYS=key_1,key_2

# Recommended Gemini model for free/low-quota use.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Site URL for SEO/sitemap.
# NEXT_PUBLIC_SITE_URL=https://seedfinder-ai-website.vercel.app
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_code

# Optional Google AdSense public settings. These are not secret, but set them in Vercel env vars.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_TOP_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=1234567891
# NEXT_PUBLIC_ADSENSE_RESULTS_SLOT=1234567892

# Optional global seed database using Upstash Redis REST.
# If these are not set, the site still works and saves seeds in the visitor's browser only.
# UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
